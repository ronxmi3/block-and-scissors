# Your LIVE Sui Testnet package from Phase 1.
SUI_PACKAGE_ID=0x5d7fa930a5d95ae7f8a2a56693e5341cb8e84dd0865fa42a6aac215c2659057a

# OracleCap created when you published the package.
SUI_ORACLE_CAP_ID=0x938048aa8ae82f694635f5723e54c3cc916554961c0b815df69556bd1a94caac

# We proved 80 works with your Move contract.
SUI_THRESHOLD=80

# 0.05 SUI maximum gas budget for oracle settlement.
SUI_GAS_BUDGET_MIST=50000000

# IMPORTANT:
# Keep this secret. The frontend/backend integration will send it in
# the X-Oracle-Key header before a real settlement is allowed.
ORACLE_API_KEY=change-this-to-a-long-random-string

# OpenCLIP model.
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# These two values map raw CLIP cosine similarity to a 0-100 demo score.
# They are NOT a scientific probability calibration.
# We will tune them using real haircut examples in Phase 2B.
SIMILARITY_FLOOR=0.50
SIMILARITY_CEILING=0.88
